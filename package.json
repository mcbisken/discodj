{
  "name": "discodj",
  "version": "3.0.0",
  "description": "Self-hosted Discord music bot: YouTube, Spotify & SoundCloud, a slick Components V2 player panel, synced lyrics, stackable filters and more.",
  "type": "module",
  "main": "src/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcbisken/discodj.git"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "lint": "eslint .",
    "test": "node --test",
    "smoke": "node --env-file-if-exists=.env scripts/smoke-audio.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "spotify-url-info": "^3.3.3",
    "youtube-search-api": "^2.0.1"
  },
  "optionalDependencies": {
    "opusscript": "^0.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
