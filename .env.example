# ── Required ───────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here

# ── Optional ───────────────────────────────────────────────────────────────
# Register slash commands instantly to these servers (comma-separated).
# Leave empty to register globally (works everywhere, can take a few minutes to show up).
GUILD_ID=

# Role(s) that count as DJ (comma-separated). Admins, Manage Server/Channels and any role
# literally named "DJ" always count.
DJ_ROLE_ID=

# DEFAULT_VOLUME=100          # 0-200, used for new servers
# IDLE_TIMEOUT=300            # seconds before leaving when nothing plays (0 = never)
# ALONE_TIMEOUT=120           # seconds before leaving when everyone else left (0 = never)
# MAX_QUEUE=1000
# MAX_PLAYLIST_SIZE=500       # max tracks pulled from one playlist/album link
# VOICE_STATUS=true           # show "🎶 Song" as the voice channel status
# AUDIO_FILTERS=on            # on | commands (hide the filter menu on the panel) | off (no filters at all)

# ── yt-dlp ─────────────────────────────────────────────────────────────────
# YTDLP_AUTO_UPDATE=true
# YTDLP_UPDATE_CHANNEL=stable # or "nightly" for the fastest YouTube fixes
# YTDLP_COOKIES=/app/data/cookies.txt   # if YouTube asks the bot to sign in (see README)
# YTDLP_JS_RUNTIME=node       # JS runtime yt-dlp uses for YouTube (node is already installed)
# YTDLP_EXTRA_ARGS=

# ── Logging ────────────────────────────────────────────────────────────────
# LOG_LEVEL=info              # debug | info | warn | error
# LOG_FORMAT=json             # json | pretty
